# Groq API — get a key at https://console.groq.com/keys
GROQ_API_KEY=

# LLM models (llama-3.3-70b-versatile and llama-3.1-8b-instant are decommissioned on Groq)
GROQ_CHAT_MODEL=qwen/qwen3.6-27b
GROQ_CLASSIFY_MODEL=openai/gpt-oss-20b

# Vector store & embeddings
CHROMA_PATH=data/processed/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Generation defaults
GROQ_CHAT_TEMPERATURE=0.1
GROQ_CLASSIFY_TEMPERATURE=0.2
GROQ_CHAT_MAX_TOKENS=256

# Retrieval (cosine distance; lower is better — calibrated on P1 filtered probes)
RETRIEVAL_MAX_DISTANCE=1.15
RETRIEVAL_TOP_K=3

# CORS — comma-separated browser origins allowed to call the API (no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: allow Vercel preview deploys (uncomment for production API)
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
